save_plot <- function(plot, path_base, width, height) {
  ggsave(paste0(path_base, ".pdf"), plot, width = width, height = height)
  ggsave(paste0(path_base, ".tiff"), plot, width = width, height = height, dpi = 300, device = "tiff")
}

# [新增] 分类模型汇总表工具函数：统计类别数、min_class_size、总训练细胞数与准确率
add_summary_row <- function(summary_df, model_name, class_counts, accuracy) {
  min_class_size <- min(class_counts)
  class_count <- length(class_counts)
  total_samples <- min_class_size * class_count
  summary_df <- rbind(
    summary_df,
    data.frame(
      model = model_name,
      class_count = class_count,
      min_class_size = min_class_size,
      total_samples = total_samples,
      accuracy = accuracy,
      stringsAsFactors = FALSE
    )
  )
  summary_df
}

