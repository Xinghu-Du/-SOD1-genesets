# 1. 二分类：ctl vs sod

data <- auc_df
data$type_binary <- ifelse(data$type == "ctl", "ctl", "sod")
data$type_binary <- factor(data$type_binary, levels = c("ctl", "sod"))
model_data_binary <- data[, c(auc_columns, "type_binary")]
model_data_binary <- model_data_binary[complete.cases(model_data_binary), ]
class_counts_binary <- table(model_data_binary$type_binary)
min_class_size_binary <- min(class_counts_binary)
balanced_samples_binary <- list()
for (class_name in names(class_counts_binary)) {
  class_data <- model_data_binary[model_data_binary$type_binary == class_name, ]
  balanced_samples_binary[[class_name]] <- class_data[sample(nrow(class_data), min_class_size_binary), ]
}
balanced_data_binary <- do.call(rbind, balanced_samples_binary)
set.seed(123)
rf_binary <- randomForest(type_binary ~ ., data = balanced_data_binary, importance = TRUE, ntree = 1000)

# 评估
print("=== 二分类模型 (ctl vs sod) - 平衡后 ===")
conf_matrix_binary <- rf_binary$confusion
total_correct_binary <- sum(diag(conf_matrix_binary[-nrow(conf_matrix_binary), ]))
total_samples_binary <- sum(conf_matrix_binary[-nrow(conf_matrix_binary), -ncol(conf_matrix_binary)])
print(paste("总体准确率:", round(total_correct_binary / total_samples_binary, 4)))
print(conf_matrix_binary)

