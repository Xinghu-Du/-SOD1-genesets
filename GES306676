# 辅助函数：可视化重要性、箱线、岭线、3D（通用函数，按目录保存）
visualize_results <- function(rf_model, balanced_data, label_col, base_dir, top_n = 4) {
  # 重要性图
  imp <- importance(rf_model, type = 2)
  imp_df <- data.frame(Variable = rownames(imp), Importance = imp[, 1])
  p_imp <- ggplot(imp_df, aes(x = Variable, y = Importance, fill = Variable)) +
    geom_bar(stat = "identity") +
    geom_abline(intercept = 30, slope = 0, color = "red") +
    theme_bw() +
    theme(axis.text.x = element_text(angle = 90, hjust = 1), legend.position = "none") +
    labs(title = "RF Feature Importance", x = "Features", y = "Importance")
  save_plot(p_imp, file.path(base_dir, "Importance", "rf_importance"), width = 7, height = 5)

  # 选 top_n 模块
  top_modules <- imp_df[order(imp_df$Importance, decreasing = TRUE), "Variable"][1:top_n]

  # 箱线图 & 岭线图
  for (mod in top_modules) {
    dat <- balanced_data[, c(mod, label_col)]
    colnames(dat) <- c("score", "group")

    # 箱线图
    p_box <- ggplot(dat, aes(x = group, y = score, fill = group)) +
      geom_boxplot() + theme_bw() + theme(legend.position = "none") +
      labs(title = paste("Boxplot:", mod), y = "AUCell Score")
    save_plot(p_box, file.path(base_dir, "Boxplots", paste0("boxplot_", mod)), width = 5, height = 5)

    # 岭线图
    p_ridge <- ggplot(dat, aes(x = score, y = group, fill = group)) +
      geom_density_ridges(alpha = 0.5) + theme_bw() + theme(legend.position = "none") +
      labs(title = paste("Ridgeline:", mod), x = "AUCell Score")
    save_plot(p_ridge, file.path(base_dir, "Ridgelines", paste0("ridgeline_", mod)), width = 5, height = 3)
  }

  # 3D图（用 top 3 模块）
  if (length(top_modules) >= 3) {
    dat_3d <- balanced_data[, c(top_modules[1:3], label_col)]
    colnames(dat_3d)[1:3] <- top_modules[1:3]
    colnames(dat_3d)[4] <- "group"

    theta <- 0
    phi <- 20
    p_3d <- ggplot(dat_3d, aes(
      x = .data[[top_modules[1]]],
      y = .data[[top_modules[2]]],
      z = .data[[top_modules[3]]],
      color = group
    )) +
      axes_3D(theta = theta, phi = phi) +
      stat_3D(theta = theta, phi = phi, alpha = 0.8, size = 0.5) +
      labs_3D(
        theta = theta,
        phi = phi,
        labs = top_modules[1:3],
        hjust = c(1, 0, 0),
        vjust = c(1.5, 1, -0.2)
      ) +
      theme_void()
    save_plot(p_3d, file.path(base_dir, "3D_Plots", "3d_scatter"), width = 5, height = 5)
  }
}

